# Salin ke .env lalu isi. File .env tidak pernah di-commit.
# URL project Supabase, mis. https://abcd.supabase.co
SUPABASE_URL=
# Anon key: hanya bisa baca (RLS), aman dipakai web
SUPABASE_ANON_KEY=
# Service role key: melewati RLS, hanya untuk skrip Python di server/lokal, jangan pernah ke browser
SUPABASE_SERVICE_ROLE_KEY=
# Sama dengan SUPABASE_URL, dibaca build Vite untuk web
VITE_SUPABASE_URL=
# Sama dengan SUPABASE_ANON_KEY, dibaca build Vite untuk web
VITE_SUPABASE_ANON_KEY=
# Token API OANDA (v20)
OANDA_TOKEN=
# ID akun OANDA, mis. 101-001-1234567-001
OANDA_ACCOUNT_ID=
# practice (demo) atau live
OANDA_ENV=practice
# MetaTrader 5 (bot_mt5.py). Mulai dengan akun DEMO HFM.
MT5_LOGIN=
MT5_PASSWORD=
# Server demo HFM, persis seperti di jendela login MT5
MT5_SERVER=
# Opsional: path terminal64.exe kalau bukan instalasi bawaan; simbol emas kalau deteksi otomatis keliru
MT5_PATH=
MT5_SYMBOL=
# demo atau live. live hanya berlaku untuk strategi lulus validasi dan setelah syarat real test demo lulus
BOT_MODE=demo
# Risiko per trade sebagai fraksi ekuitas (0.05 = 5%), dibatasi maksimal 0.10
BOT_RISK=0.05
